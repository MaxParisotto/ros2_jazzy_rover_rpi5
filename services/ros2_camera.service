[Unit]
Description=ROS2 Orbbec Camera Node
After=network.target

[Service]
Type=simple
User=max
Group=max
WorkingDirectory=/home/max/ros2_ws
Environment="HOME=/home/max"
Environment="ROS_DOMAIN_ID=0"

ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/max/ros2_ws/install/setup.bash && ros2 launch my_custom_nodes orbbec_camera_launch.py'

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
