[Unit]
Description=ROS2 Rover Full Bringup (LiDAR, Camera, SLAM, Foxglove)
After=network.target ros2_bbb_bridge.service
Wants=ros2_bbb_bridge.service

[Service]
Type=simple
User=max
Group=max
WorkingDirectory=/home/max/ros2_ws
Environment="HOME=/home/max"
Environment="ROS_DOMAIN_ID=0"
Environment="DISPLAY=:0"

# Wait for BBB bridge to be ready
ExecStartPre=/bin/sleep 5

ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/max/ros2_ws/install/setup.bash && ros2 launch my_custom_nodes rover_bringup_launch.py'

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
